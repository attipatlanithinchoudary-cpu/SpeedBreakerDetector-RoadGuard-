<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- The MapView should be the first element, so it stays in the background -->


    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/predictionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Prediction: None"
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#66000000"
        android:textColor="@android:color/white"
        android:visibility="gone"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/view_history_button"/>




    <!-- CardView to hold the search bar fragment for a nice look -->
    <androidx.cardview.widget.CardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/fromSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />



        <LinearLayout
            android:id="@+id/fromToContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/search_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/fromLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="From (Current location)"
                android:enabled="false"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:padding="8dp" />

            <EditText
                android:id="@+id/toLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="To"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:padding="8dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>



        <!-- The Autocomplete Support Fragment for the search bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- COLLAPSED SEARCH BAR -->
            <LinearLayout
                android:id="@+id/collapsedSearchLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@android:color/white"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search a place"
                    android:textSize="16sp"
                    android:textColor="@android:color/darker_gray" />
            </LinearLayout>

            <!-- EXPANDED SEARCH (FROM → TO) -->
            <LinearLayout
                android:id="@+id/expandedSearchLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@android:color/white"
                android:visibility="gone">

                <!-- FROM -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/fromLocationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current location"
                    android:padding="8dp"
                    android:background="#EEEEEE"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- TO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <fragment
                    android:id="@+id/toAutocomplete"
                    android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </LinearLayout>


        </FrameLayout>


    </androidx.cardview.widget.CardView>


    <Button
        android:id="@+id/filterToggleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"

        android:text="Filters"

        app:layout_constraintBaseline_toBaselineOf="@id/button_report_pothole"
        app:layout_constraintStart_toEndOf="@id/button_report_pothole" />

    <LinearLayout
        android:id="@+id/filterPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_filter_panel"
        android:elevation="8dp"

    app:layout_constraintTop_toBottomOf="@id/search_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hazard Types"
            android:textStyle="bold"
            android:textSize="14sp" />


        <CheckBox
            android:id="@+id/filterSpeedBreaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed Breaker"
            android:checked="true" />

        <CheckBox
            android:id="@+id/filterPothole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pothole"
            android:checked="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Severity Levels"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingTop="6dp" />


        <CheckBox
            android:id="@+id/filterLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low"
            android:checked="true" />

        <CheckBox
            android:id="@+id/filterMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:checked="true" />

        <CheckBox
            android:id="@+id/filterHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:checked="true" />

    </LinearLayout>



    <!-- All your other UI elements remain unchanged -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="#80000000"
        android:padding="8dp"
        android:text="Status: Stopped"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/button_report_pothole"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="Warning"
        app:layout_constraintBottom_toTopOf="@id/start_button"
        app:layout_constraintEnd_toStartOf="@id/button_report_pothole"
        app:layout_constraintTop_toTopOf="@id/button_report_pothole"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/button_report_pothole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Report"
        app:layout_constraintBottom_toTopOf="@id/start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/start_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="Start Detection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/stop_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Stop Detection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/view_history_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="Refresh History and Map"
        app:layout_constraintBottom_toTopOf="@+id/status_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



    <TextView
    android:id="@+id/detection_history_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"

    android:layout_marginStart="16dp"
    android:layout_marginTop="72dp"
    android:padding="6dp"

    android:text="Real-Time Sensor Logs:\nZ-axis: 0.00 m/s²"
    android:textSize="13sp"
    android:textStyle="bold"
    android:textColor="@android:color/white"

    android:background="#66000000"
    android:elevation="6dp"

    android:visibility="visible"

    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/recenterFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="300dp"
        android:src="@drawable/ic_my_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/zoomOutFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="180dp"
        android:src="@drawable/ic_zoom_out"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/zoomInFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="240dp"
        android:src="@drawable/ic_zoom_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/speedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="120dp"
        android:background="#66000000"
        android:padding="8dp"
        android:text="0 km/h"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>


